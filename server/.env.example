# ==============================================
# OVH 控制台 (Go server) - 配置文件
# 复制此文件为 .env 并修改配置值
# ==============================================

# API 安全密钥（登录网页时填它）
# 生成方法: openssl rand -hex 24
# 留空则首次启动自动生成一把并写回本文件；填 123456 这种公开值会被强制只监听本机
API_SECRET_KEY=

# 后端端口
PORT=19998

# 调试模式（开发: true, 生产: false）
DEBUG=false

# 是否启用 API 密钥验证
ENABLE_API_KEY_AUTH=true

# 监听地址。默认空 = 所有网卡（localhost / 127.0.0.1 / 局域网 IP 都能访问）
# 想锁回环写 127.0.0.1；公网部署写 0.0.0.0
LISTEN_HOST=

# Gin 模式: debug / release
GIN_MODE=release

# 数据库加密密钥（首次启动自动生成并写回这个文件，通常不用自己填）
# 加密的是数据库里的 OVH API 凭据和 Telegram Token —— 拿到 sniper.db
# 就等于拿到你 OVH 账户的完全控制权（能下单、能重装、能删机器）。
#
# 备份配置文件时别漏了这一行：丢了它，已保存的账户就再也解不开，只能重新录入。
# 想让密钥完全不落盘，就用环境变量传进来（容器里推荐这么做），这个文件里就别写。
# OVH_DB_KEY=

# 配置文件自身的位置。默认是工作目录下的 .env。
# systemd / docker 里工作目录未必是程序所在目录，那种情况下写绝对路径，
# 否则密钥可能"这次写进去、下次找不到"。
# OVH_ENV_FILE=/etc/ovh-console/.env

# App 配对二维码里用的公网地址（HTTPS 反代后面时填，例如 https://panel.example.com）。
# 不填就按请求推断：直连 TLS 或反代带 X-Forwarded-Proto: https 时用 https
# PUBLIC_BASE_URL=
